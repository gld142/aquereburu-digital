# ===========================================
# AQUEREBURU & PARTNERS — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/aquereburu?schema=public"

# --- Authentication (NextAuth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"  # Generate with: openssl rand -base64 32

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth (optional)
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""

# --- AI / LLM ---
ANTHROPIC_API_KEY=""                     # Claude API key
AI_DEFAULT_MODEL="claude-sonnet-4-6"   # Model for daily operations
AI_COMPLEX_MODEL="claude-opus-4-6"     # Model for complex analysis
AI_EMBEDDING_MODEL="multilingual-e5-large"
AI_MAX_TOKENS="4096"
AI_TEMPERATURE="0.1"

# --- Vector Database ---
# PINECONE_API_KEY=""
# PINECONE_ENVIRONMENT=""
# PINECONE_INDEX=""

# --- Payment ---
# Stripe
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Mobile Money (Togo)
# FLOOZ_API_KEY=""
# FLOOZ_MERCHANT_ID=""
# T_MONEY_API_KEY=""
# T_MONEY_MERCHANT_ID=""

# --- Email (Resend) ---
# RESEND_API_KEY=""
# EMAIL_FROM="Site Aquereburu <site@aquereburu-partners.com>"   # domaine vérifié chez Resend
# CONTACT_TO="contact@aquereburu-partners.com"   # destinataire(s) des formulaires, séparés par des virgules

# --- 2FA (Twilio) ---
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# --- File Storage ---
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# --- OCR ---
# GOOGLE_CLOUD_VISION_KEY=""

# --- Analytics ---
# PLAUSIBLE_DOMAIN=""
# POSTHOG_KEY=""
# POSTHOG_HOST=""

# --- Monitoring ---
# SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""

# --- URLs ---
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_FONDATION_URL="http://localhost:3001"
NEXT_PUBLIC_PLATFORM_URL="http://localhost:3002"
